// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role enum for user access control
enum Role {
  OWNER
  PROJECT_MANAGER
  FIELD_WORKER
  SUBCONTRACTOR
  CLIENT
}

// Plan enum for organization subscription tiers
enum Plan {
  STARTER
  PRO
}

// Subscription status enum
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

// Project status enum
enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

// Organization model - represents a company/builder
model Organization {
  id               String    @id @default(cuid())
  name             String
  plan             Plan      @default(STARTER)

  // Stripe integration
  stripeCustomerId String?   @unique

  // Google Drive integration
  driveFolderId    String?   @unique

  // Subscription tracking
  subscriptionId   String?   @unique
  subscriptionStatus SubscriptionStatus?
  trialEndsAt      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  users            User[]
  projects         Project[]

  @@index([stripeCustomerId])
  @@index([subscriptionStatus])
  @@map("organizations")
}

// User model - authenticated users within organizations
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  clerkId        String       @unique
  name           String?
  role           Role         @default(FIELD_WORKER)
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([clerkId])
  @@index([organizationId])
  @@map("users")
}

// Project model - construction projects
model Project {
  id             String        @id @default(cuid())
  name           String
  address        String
  status         ProjectStatus @default(PLANNING)
  organizationId String

  // Google Drive integration
  driveFolderId  String?       @unique

  // Project details
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([driveFolderId])
  @@map("projects")
}
