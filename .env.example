# ===================================
# CLERK AUTHENTICATION
# ===================================
# Get these from https://dashboard.clerk.com
# Enable organizations and configure custom roles:
# - OWNER (full access)
# - PROJECT_MANAGER (manage projects)
# - FIELD_WORKER (view & update)
# - SUBCONTRACTOR (limited access)
# - CLIENT (read-only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk URL Configuration (do not change these)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===================================
# GOOGLE OAUTH (via Clerk)
# ===================================
# Configure OAuth in Clerk dashboard
# Enable Google Drive API for document storage
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ===================================
# DATABASE (SUPABASE POSTGRESQL)
# ===================================
# Use Supabase connection pooler URL for better performance
# Format: postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
# Get from: Supabase Dashboard > Project Settings > Database > Connection Pooling
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:your-password@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# ===================================
# STRIPE PAYMENTS
# ===================================
# Get these from https://dashboard.stripe.com
# Create products: Starter ($49/mo) and Pro ($99/mo)
# Configure 14-day trial period in Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx

# ===================================
# APP CONFIGURATION
# ===================================
# Set to your production URL in Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# ANTHROPIC AI (CLAUDE API)
# ===================================
# Get from https://console.anthropic.com
# Used for AI-powered project insights and document analysis
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
